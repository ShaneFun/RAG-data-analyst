# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit real keys.

# --- Database ---
# Admin connection: only used by the setup script (data.setup_db), never by the API.
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/larkspur
# Read-only connection: the only credential the API uses (agent SQL + knowledge search).
DATABASE_URL_RO=postgresql://analyst_ro:analyst_ro@localhost:5432/larkspur
ANALYST_RO_PASSWORD=analyst_ro

# --- LLM (DeepSeek) ---
DEEPSEEK_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# --- API ---
RATE_LIMIT=10/hour
DAILY_QUESTION_LIMIT=200/day
ALLOWED_ORIGINS=http://localhost:3000
